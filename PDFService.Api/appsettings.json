{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // "ApplicationInsights": {
  //   "InstrumentationKey": "<put your instrumentation key here>"
  // },
  "PdfOptions": {
    "FontName": "times.ttf,timesbd.ttf,timesbi.ttf,timesi.ttf",
    "ColorProfile": "sRGB_IEC61966-2-1_no_black_scaling.icc"
  },
  "RetryOptions": {
    "Retry": {
      "BackoffType": "Linear",
      "UseJitter": false,
      "MaxRetryAttempts": 7
    }
  }
}
